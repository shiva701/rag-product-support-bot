{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "product-support-bot",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      // No --reload: reload runs the app in a child process, where breakpoints don't stop.
      "args": ["api:app", "--host", "127.0.0.1", "--port", "8000"],
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": { "PYTHONUNBUFFERED": "1" },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
